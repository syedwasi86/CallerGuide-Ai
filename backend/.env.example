# ====================================================================
# CallGuide AI Backend Environment Variables
# Source: doc/PRODUCT_SPEC.md & Phase 4 Specifications
# ====================================================================

# Server Configuration
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_ORIGIN=http://localhost:3000

# Supabase PostgreSQL Configuration
# Obtain from Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# IMPORTANT: Use the SERVICE_ROLE key on the backend ONLY. Never expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# LLM Provider Configuration (Phase 5, 5.1 & 5.2)
# Supported providers: "gemini" or "groq"
LLM_PROVIDER=gemini

# Google Gemini Settings (obtain key from https://aistudio.google.com)
LLM_API_KEY=your-gemini-api-key
LLM_MODEL=gemini-3.5-flash-lite

# Groq Settings (obtain key from https://console.groq.com)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b

# LLM Timeout Configuration (in seconds)
LLM_CONNECT_TIMEOUT_SECONDS=5.0
LLM_READ_TIMEOUT_SECONDS=20.0
LLM_WRITE_TIMEOUT_SECONDS=10.0
LLM_POOL_TIMEOUT_SECONDS=5.0
