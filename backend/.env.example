# ====================================================================
# CallGuide AI Backend Environment Variables
# Source: doc/PRODUCT_SPEC.md & Phase 4 Specifications
# ====================================================================

# Server Configuration
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_ORIGIN=http://localhost:3000

# Supabase PostgreSQL Configuration
# Obtain from Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# IMPORTANT: Use the SERVICE_ROLE key on the backend ONLY. Never expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# LLM Provider Configuration (Phase 5)
# Obtain from Google AI Studio (https://aistudio.google.com).
# Kept securely on backend only. If omitted or unreachable, backend seamlessly uses transcript-backed heuristics.
LLM_API_KEY=your-gemini-api-key
LLM_MODEL=gemini-2.5-flash
